{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MrFocusMasterTemplate",
  "description": "Plantilla Maestra JSON Completa para generar Proyectos, Hábitos, Tareas, Bloques de Calendario y Notas en mr focus",
  "type": "object",
  "required": ["version", "template"],
  "properties": {
    "version": { "type": "string", "enum": ["1.0"] },
    "template": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "author": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "projects": { "type": "array" },
        "habits": { "type": "array" },
        "tasks": { "type": "array" },
        "events": { "type": "array" },
        "notes": { "type": "array" }
      }
    }
  }
}
